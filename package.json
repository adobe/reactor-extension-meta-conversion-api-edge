{
  "name": "@adobe/reactor-extension-meta-conversion-api-edge",
  "platform": "edge",
  "version": "1.10.0-beta.1",
  "apiVersion": "v24.0",
  "description": "Send web events to Meta's Conversions API.",
  "author": {
    "name": "Adobe",
    "url": "http://adobe.com",
    "email": "reactor@adobe.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:adobe/reactor-extension-meta-conversion-api-edge.git"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:watch": "webpack --mode development --watch",
    "clean": "rm -rf dist",
    "sandbox": "concurrently -k -n webpack,sandbox -c \"bgBlue,bgMagenta\" \"npm run build:watch\" \"reactor-sandbox\"",
    "package": "npm run clean && npm run build && npx @adobe/reactor-packager",
    "prepack": "npm run clean && npm run build",
    "lint": "eslint 'src/**'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "update": "rm -rf node_modules package-lock.json && npm i",
    "prepare": "husky install"
  },
  "dependencies": {
    "@adobe/react-spectrum": "^3.47.0",
    "@spectrum-icons/illustrations": "^3.7.0",
    "@spectrum-icons/workflow": "^4.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-stately": "^3.46.0"
  },
  "devDependencies": {
    "@adobe/reactor-sandbox": "^13.4.0",
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-import-assertions": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/runtime": "^7.29.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.3.0",
    "babel-loader": "^10.1.1",
    "camelcase": "^9.0.0",
    "capitalize": "^2.0.4",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.3.4",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-runner-eslint": "^2.3.0",
    "jest-transform-stub": "^2.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "style-loader": "^4.0.0",
    "stylus": "^0.64.0",
    "stylus-loader": "^8.1.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "yargs": "^18.0.0"
  }
}
